# Web app (apps/web). Copy to apps/web/.env.local for local runs; never commit real values.
SESSION_SECRET=change-me
# Pins the demo date for repeatable runs (YYYY-MM-DD). Defaults to today in JST.
SEED_DATE=
# Set to call the agent service; without it the app uses local fallbacks.
AGENTS_BASE_URL=

# Google Cloud
GCP_PROJECT=
GCP_REGION=asia-northeast1
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
MEDIA_BUCKET=
BQ_DATASET=gembaleap
KMS_KEY_AUDIT=

# Agent service (services/agents)
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=
GOOGLE_GENAI_USE_VERTEXAI=true
# Synthetic data for local agent runs: pnpm --filter @gembaleap/seed export
SEED_PATH=../../packages/seed/dist/seed.json

# Optional chat channels
LINE_CHANNEL_SECRET=
WHATSAPP_TOKEN=
